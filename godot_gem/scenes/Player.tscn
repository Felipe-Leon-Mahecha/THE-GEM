[gd_scene load_steps=3 format=3 uid="uid://player_gem"]

[ext_resource type="Script" path="res://scripts/player.gd" id="1_player"]

; ── Forma de colisión del jugador: cápsula pequeña ──────────────────────────
[sub_resource type="CapsuleShape2D" id="2_shape"]
radius = 14.0
height = 28.0

; ════════════════════════════════════════════════════════════════════════════
; Árbol de nodos:
;
;   Player  (CharacterBody2D)  ← raíz, lleva el script
;   ├── CollisionShape2D       ← hitbox física
;   └── Visual  (Node2D)       ← pivote de rotación visual
;       └── Sprite2D           ← sprite del personaje (placeholder triángulo)
; ════════════════════════════════════════════════════════════════════════════

[node name="Player" type="CharacterBody2D"]
script = ExtResource("1_player")
; Valores por defecto — ajusta en Inspector sin tocar el código
outer_radius = 340.0
inner_radius = 160.0
speed = 220.0
jump_force = 380.0
gravity_strength = 600.0
flip_transition_time = 0.18

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("2_shape")

; Visual es el nodo que player.gd rota para alinear los "pies" a la superficie.
; Todo lo visible (sprite, efectos, animaciones) debe ir DENTRO de este nodo.
[node name="Visual" type="Node2D" parent="."]

; Sprite placeholder: un triángulo blanco hecho con Polygon2D.
; Reemplázalo con tu Sprite2D o AnimatedSprite2D cuando tengas el arte.
[node name="Body" type="Polygon2D" parent="Visual"]
; Triángulo apuntando "arriba" (hacia los pies del jugador cuando está parado)
polygon = PackedVector2Array(0, -18, 12, 14, -12, 14)
color = Color(0.95, 0.95, 0.95, 1.0)
